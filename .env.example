# Copia questo file in .env.local e compila i valori.
# .env.local non va MAI committato.

# Chiave API Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Modello AI: default il piu' economico. Per testare un modello superiore
# sulla qualita' comica basta cambiare questo valore.
AI_MODEL=claude-haiku-4-5

# Progetto Supabase: Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salt per l'hash degli IP (una stringa lunga casuale qualsiasi)
IP_HASH_SALT=

# Chiave segreta del pannello nascosto /admin (minimo 8 caratteri,
# consigliata lunga e casuale). Si entra UNA volta con
# /admin?chiave=QUESTO_VALORE, poi basta un cookie di 30 giorni.
ADMIN_SECRET=

# Feature flag del futuro sblocco quiz (lasciare off in v1)
QUIZ_GATE=off

# Link esterno per le donazioni (Ko-fi, PayPal.me o simile)
NEXT_PUBLIC_DONATION_URL=

# URL pubblico del sito, usato per metadata e immagini OG
# In locale: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email mostrata in /info per segnalazioni e richieste di rimozione
NEXT_PUBLIC_CONTACT_EMAIL=
